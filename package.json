{
  "name": "vscode-productivity-tracker",
  "version": "1.0.0",
  "description": "A full-stack VSCode productivity and wellbeing tracker",
  "private": true,
  "workspaces": [
    "vscode-extension",
    "server", 
    "dashboard"
  ],
  "scripts": {
    "dev:extension": "cd vscode-extension && npm run watch",
    "dev:server": "cd server && npm run dev",
    "dev:dashboard": "cd dashboard && npm run dev",
    "build:all": "npm run build --workspaces",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
