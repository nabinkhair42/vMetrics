{
  "name": "vmetrics",
  "version": "1.0.0",
  "private": true,
  "description": "Developer productivity tracking platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "server:dev": "pnpm --filter @vmetrics/server dev",
    "dashboard:dev": "pnpm --filter @vmetrics/dashboard dev",
    "extension:dev": "pnpm --filter @vmetrics/vscode-extension dev"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
